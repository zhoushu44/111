NODE_ENV=production
PORT=3000
# Docker Compose 中主机名必须为 postgres；部署时与 infra/.env 的 POSTGRES_PASSWORD 保持一致
# 连接池与超时参数，用于防止连接卡死耗尽连接池（远程/跨网络高延迟场景尤其需要）：
#   connection_limit             连接池上限
#   pool_timeout                 从池中获取连接的超时（秒）
#   max_idle_connection_lifetime 空闲连接存活上限（秒），到期回收
#   max_connection_lifetime      连接最长存活（秒），到期强制轮换
#   socket_timeout               socket 读写超时（秒），避免半开连接永久挂起
DATABASE_URL="postgresql://erp:replace-with-a-long-random-password@postgres:5432/fabric_erp?schema=public&connection_limit=10&pool_timeout=10&max_idle_connection_lifetime=60&max_connection_lifetime=600&socket_timeout=30"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-at-least-32-random-characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# 仅填写正式 HTTPS 前端来源；多个来源时须确认应用的 CORS 配置支持其格式
CORS_ORIGIN=https://erp.example.com
# 每个 IP 在对应限流窗口内允许的最大请求数，按业务容量调整
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REFRESH_RATE_LIMIT_MAX=30
UPLOAD_RATE_LIMIT_MAX=30

# ===== 备份配置 =====
# 备份文件存放目录（相对进程工作目录）
BACKUP_DIR=backups
# 数据库备份加密口令。数据库中存有明文 AI 密钥，生产环境必须配置此项，
# 否则备份以明文落盘，一旦泄露会导致密钥被窃取。
# 生成方式：openssl rand -hex 32
BACKUP_ENCRYPTION_PASSPHRASE=replace-with-a-long-random-passphrase
# 本地备份保留天数
BACKUP_RETAIN_DAYS=7
# pg_dump 可执行文件路径。容器内通常为 pg_dump（已在 PATH 中），
# 若使用外部数据库或集成环境（如 ServBay），需指定绝对路径。
PG_DUMP_PATH=pg_dump

# ===== 初始账号密码（仅首次创建账号时生效）=====
# 已存在的账号不会被覆盖密码，因此修改此项不影响既有用户。
ADMIN_INIT_PASSWORD=replace-with-a-strong-password
STAFF_INIT_PASSWORD=replace-with-a-strong-password
