generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleCode {
  ADMIN
  STAFF
}

enum AccountStatus {
  ACTIVE
  DISABLED
}

enum RecordStatus {
  ACTIVE
  DISABLED
}

enum DocumentStatus {
  ACTIVE
  VOIDED
}

model Role {
  id          String        @id @default(uuid()) @db.Uuid
  code        RoleCode      @unique
  name        String        @unique @db.VarChar(50)
  description String?       @db.VarChar(255)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  users       UserAccount[]
  @@map("role")
}

model UserAccount {
  id           String        @id @default(uuid()) @db.Uuid
  username     String        @unique @db.VarChar(50)
  displayName  String        @db.VarChar(100)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  status       AccountStatus @default(ACTIVE)
  roleId       String        @map("role_id") @db.Uuid
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  role         Role          @relation(fields: [roleId], references: [id])
  sessions     UserSession[]
  sampleChooses SampleChoose[] @relation("sample_choose_creator")
  operationLogs OperationLog[]
  @@index([roleId])
  @@map("user_account")
}

model UserSession {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @map("user_id") @db.Uuid
  refreshTokenHash String      @map("refresh_token_hash") @db.VarChar(255)
  deviceName       String?     @map("device_name") @db.VarChar(255)
  expiresAt        DateTime    @map("expires_at")
  revokedAt        DateTime?   @map("revoked_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  user             UserAccount @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("user_session")
}

model MaterialCategory {
  id          String              @id @default(uuid()) @db.Uuid
  name        String              @unique @db.VarChar(100)
  code        String?             @unique @db.VarChar(50)
  description String?             @db.VarChar(500)
  parentId    String?             @map("parent_id") @db.Uuid
  status      RecordStatus        @default(ACTIVE)
  sortOrder   Int                 @default(0) @map("sort_order")
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")
  parent      MaterialCategory?   @relation("category_tree", fields: [parentId], references: [id])
  children    MaterialCategory[]  @relation("category_tree")
  fabrics     MaterialFabric[]
  @@index([parentId, status])
  @@map("material_category")
}

model Provider {
  id                  String           @id @default(uuid()) @db.Uuid
  code                String           @unique @db.VarChar(50)
  name                String           @db.VarChar(150)
  // 基本资料
  chineseShortName    String?          @map("chinese_short_name") @db.VarChar(100) // 中文简称
  shortName           String?          @map("short_name") @db.VarChar(100) // 英文简称
  fullName            String?          @map("full_name") @db.VarChar(200) // 英文全称
  type                String?          @db.VarChar(50) // 供应商 / 加工商 / 供应加工商
  businessType        String?          @map("business_type") @db.VarChar(100)
  businessUnit        String?          @map("business_unit") @db.VarChar(150) // 经营单位
  city                String?          @db.VarChar(100) // 城市
  isMonthlySettlement Boolean?         @default(false) @map("is_monthly_settlement")
  isSilkSupplier      Boolean?         @default(false) @map("is_silk_supplier") // 是否供应绢
  merchandiser        String?          @db.VarChar(100) // 跟单员
  paymentDays         Int?             @map("payment_days") // 收款天数
  invoiceDays         Int?             @map("invoice_days") // 发票天数
  mainProducts        String?          @map("main_products") @db.VarChar(500) // 经营产品
  equipmentCapacity   String?          @map("equipment_capacity") @db.VarChar(500) // 设备产量
  // 联系方式
  contact             String?          @db.VarChar(100)
  phone               String?          @db.VarChar(50)
  mobile              String?          @db.VarChar(50)
  email               String?          @db.VarChar(100)
  address             String?          @db.VarChar(255)
  otherContacts       String?          @map("other_contacts") @db.VarChar(500) // 其他联系人
  // 开票资料（敏感）
  bankName            String?          @map("bank_name") @db.VarChar(150) // 开户行
  bankAccount         String?          @map("bank_account") @db.VarChar(100) // 账号
  invoiceNo           String?          @map("invoice_no") @db.VarChar(100) // 票号
  taxId               String?          @map("tax_id") @db.VarChar(50) // 税务号
  invoiceRatio        Decimal?         @map("invoice_ratio") @db.Decimal(5, 2) // 开票比例 %
  invoiceNote         String?          @map("invoice_note") @db.VarChar(500) // 开票注意
  registeredAddress   String?          @map("registered_address") @db.VarChar(255) // 登记地址
  status              RecordStatus     @default(ACTIVE)
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")
  fabrics             MaterialFabric[]
  @@index([name])
  @@index([shortName])
  @@map("provider")
}

model Customer {
  id              String         @id @default(uuid()) @db.Uuid
  code            String         @unique @db.VarChar(50)
  name            String         @db.VarChar(150)
  // 基本资料
  shortName       String?        @map("short_name") @db.VarChar(100)
  fullName        String?        @map("full_name") @db.VarChar(200)
  type            String?        @db.VarChar(50)
  intermediary    String?        @map("intermediary") @db.VarChar(100)
  businessType    String?        @map("business_type") @db.VarChar(100)
  salesman        String?        @db.VarChar(100)
  businessUnit    String?        @map("business_unit") @db.VarChar(150)
  brandName       String?        @map("brand_name") @db.VarChar(150)
  registeredAt    DateTime?      @map("registered_at") @db.Date
  // 业务信息
  monthlySettlement Boolean?     @default(false) @map("monthly_settlement")
  paymentDays     Int?           @map("payment_days")
  creditLimit     Decimal?       @map("credit_limit") @db.Decimal(12, 2)
  mainProducts    String?        @map("main_products") @db.VarChar(500)
  remark          String?        @db.VarChar(500)
  // 联系地址
  country         String?        @db.VarChar(50)
  province        String?        @db.VarChar(50)
  city            String?        @db.VarChar(50)
  postalCode      String?        @map("postal_code") @db.VarChar(20)
  address         String?        @db.VarChar(255)
  shippingAddress String?        @map("shipping_address") @db.VarChar(255)
  // 联系人
  contact         String?        @db.VarChar(100)
  generalManager  String?        @map("general_manager") @db.VarChar(100)
  phone           String?        @db.VarChar(50)
  mobile          String?        @db.VarChar(50)
  email           String?        @db.VarChar(100)
  fax             String?        @db.VarChar(50)
  otherContacts   String?        @map("other_contacts") @db.VarChar(500)
  status          RecordStatus   @default(ACTIVE)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  chooses         SampleChoose[]
  @@index([name])
  @@index([shortName])
  @@map("customer")
}

model MaterialFabric {
  id          String            @id @default(uuid()) @db.Uuid
  itemNo      String            @unique @map("item_no") @db.VarChar(100)
  name        String            @db.VarChar(150)
  specification String?         @db.VarChar(255)
  composition   String?         @db.VarChar(255)
  construction  String?         @db.VarChar(255)
  width         String?         @db.VarChar(100)
  weight        String?         @db.VarChar(100)
  color         String?         @db.VarChar(100)
  unit          String          @default("米") @db.VarChar(20)
  factoryNo     String?         @map("factory_no") @db.VarChar(100) // 工厂编号
  fabricSource  String?         @map("fabric_source") @db.VarChar(100) // 面料来源
  processingMethod String?      @map("processing_method") @db.VarChar(100) // 加工方式
  remark        String?         @db.VarChar(500)
  labelRemark   String?         @map("label_remark") @db.VarChar(500)
  cost          Decimal?        @db.Decimal(12, 2)
  categoryId  String            @map("category_id") @db.Uuid
  providerId  String?           @map("provider_id") @db.Uuid
  status      RecordStatus      @default(ACTIVE)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  category    MaterialCategory  @relation(fields: [categoryId], references: [id])
  provider    Provider?         @relation(fields: [providerId], references: [id])
  images      MaterialImage[]
  colors      MaterialColor[]
  changeLogs  MaterialChangeLog[]
  chooseItems SampleChooseItem[]
  @@index([name])
  @@index([categoryId])
  @@index([providerId])
  // 列表默认按 updatedAt desc 排序 常带 status 过滤 复合索引避免排序算子
  @@index([status, updatedAt])
  // 前端类别筛选为高频场景 复合索引前缀覆盖 categoryId 单字段查询
  @@index([categoryId, status, updatedAt])
  @@map("material_fabric")
}

model MaterialImage {
  id         String          @id @default(uuid()) @db.Uuid
  materialId String          @map("material_id") @db.Uuid
  url        String          @db.VarChar(500)
  thumbnailUrl String?       @map("thumbnail_url") @db.VarChar(500)
  sortOrder  Int             @default(0) @map("sort_order")
  createdAt  DateTime        @default(now()) @map("created_at")
  material   MaterialFabric  @relation(fields: [materialId], references: [id], onDelete: Cascade)
  @@index([materialId, sortOrder])
  @@map("material_image")
}

// 公司颜色色：面料下挂的多条颜色分类子表，每条可附带一张颜色图片
model MaterialColor {
  id               String         @id @default(uuid()) @db.Uuid
  materialId       String         @map("material_id") @db.Uuid
  customerColorNo  String?        @map("customer_color_no") @db.VarChar(100) // 客户色号/花号
  color            String?        @db.VarChar(100) // 颜色
  processingColorNo String?       @map("processing_color_no") @db.VarChar(100) // 加工色号/花号
  colorOverview    String?        @map("color_overview") @db.VarChar(500) // 颜色概况
  colorWeight      String?        @map("color_weight") @db.VarChar(100) // 颜色克重
  designer         String?        @db.VarChar(100) // 设计人
  providerFactory  String?        @map("provider_factory") @db.VarChar(200) // 供应/加工厂
  orderCustomer    String?        @map("order_customer") @db.VarChar(200) // 订单客户
  processingFee    String?        @map("processing_fee") @db.VarChar(100) // 加工费用
  product          String?        @db.VarChar(200) // 产品
  image            String?        @db.VarChar(500) // 颜色图片 url
  sortOrder        Int            @default(0) @map("sort_order")
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")
  material         MaterialFabric @relation(fields: [materialId], references: [id], onDelete: Cascade)
  @@index([materialId, sortOrder])
  @@map("material_color")
}

// 面料更改记录：逐字段记录每次创建/修改/状态变更/图片操作，便于追溯
model MaterialChangeLog {
  id               String       @id @default(uuid()) @db.Uuid
  materialId       String       @map("material_id") @db.Uuid
  userId           String?      @map("user_id") @db.Uuid
  userDisplayName  String?      @map("user_display_name") @db.VarChar(100)
  action           String       @db.VarChar(50) // CREATE / UPDATE / TOGGLE / UPLOAD_IMAGE / DELETE_IMAGE
  field            String?      @db.VarChar(50) // 字段 key，null 表示汇总型操作
  fieldLabel       String?      @map("field_label") @db.VarChar(50) // 字段中文名
  oldValue         String?      @map("old_value") @db.VarChar(500)
  newValue         String?      @map("new_value") @db.VarChar(500)
  ip               String?      @db.VarChar(64)
  createdAt        DateTime     @default(now()) @map("created_at")
  material         MaterialFabric @relation(fields: [materialId], references: [id], onDelete: Cascade)
  @@index([materialId, createdAt])
  @@map("material_change_log")
}

model SampleChoose {
  id           String         @id @default(uuid()) @db.Uuid
  documentNo   String         @unique @map("document_no") @db.VarChar(50)
  customerId   String         @map("customer_id") @db.Uuid
  customerName String         @map("customer_name") @db.VarChar(150)
  status       DocumentStatus @default(ACTIVE)
  remark       String?        @db.VarChar(500)
  // 选样扩展字段（参照老系统 HSTIP 选样管理）
  contact        String?      @db.VarChar(100) // 联系人
  currency       String?      @default("CNY") @db.VarChar(20) // 币种
  requirement    String?      @db.VarChar(500) // 要求
  expressNo      String?      @map("express_no") @db.VarChar(100) // 快递单号
  expressCompany String?      @map("express_company") @db.VarChar(100) // 快递公司
  salesperson    String?      @db.VarChar(100) // 销售员
  sampleType     String?      @map("sample_type") @db.VarChar(50) // 选样类型
  unsampledType  String?      @map("unsampled_type") @db.VarChar(50) // 未样类型
  printedAt      DateTime?    @map("printed_at") // 打印时间
  createdById  String         @map("created_by_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  voidedAt     DateTime?      @map("voided_at")
  customer     Customer       @relation(fields: [customerId], references: [id])
  createdBy    UserAccount    @relation("sample_choose_creator", fields: [createdById], references: [id])
  items        SampleChooseItem[]
  @@index([customerId, createdAt])
  @@index([createdById, createdAt])
  @@map("sample_choose")
}

model SampleChooseItem {
  id             String          @id @default(uuid()) @db.Uuid
  sampleChooseId String          @map("sample_choose_id") @db.Uuid
  materialId     String          @map("material_id") @db.Uuid
  itemNoSnapshot String          @map("item_no_snapshot") @db.VarChar(100)
  nameSnapshot   String          @map("name_snapshot") @db.VarChar(150)
  specSnapshot   String?         @map("spec_snapshot") @db.VarChar(255)
  unitSnapshot           String?  @map("unit_snapshot")        @db.VarChar(20)
  compositionSnapshot    String?  @map("composition_snapshot") @db.VarChar(255) // 成分快照
  constructionSnapshot   String?  @map("construction_snapshot") @db.VarChar(255) // 组织快照
  widthSnapshot          String?  @map("width_snapshot")       @db.VarChar(100)  // 幅宽快照
  weightSnapshot         String?  @map("weight_snapshot")      @db.VarChar(100)  // 克重快照
  factoryNoSnapshot      String?  @map("factory_no_snapshot")  @db.VarChar(100)  // 工厂编号快照
  quantity       Int
  remark         String?         @db.VarChar(500)
  createdAt      DateTime        @default(now()) @map("created_at")
  sampleChoose   SampleChoose    @relation(fields: [sampleChooseId], references: [id], onDelete: Cascade)
  material       MaterialFabric  @relation(fields: [materialId], references: [id])
  @@unique([sampleChooseId, materialId])
  @@index([materialId])
  @@map("sample_choose_item")
}

model OperationLog {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String?      @map("user_id") @db.Uuid
  action     String       @db.VarChar(100)
  resource   String       @db.VarChar(100)
  resourceId String?      @map("resource_id") @db.VarChar(100)
  detail     Json?
  ip         String?      @db.VarChar(64)
  createdAt  DateTime     @default(now()) @map("created_at")
  user       UserAccount? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([resource, createdAt])
  @@map("operation_log")
}

model DataDictionary {
  id        String       @id @default(uuid()) @db.Uuid
  type      String       @db.VarChar(50)
  code      String       @db.VarChar(50)
  label     String       @db.VarChar(100)
  value     String?      @db.VarChar(255)
  status    RecordStatus @default(ACTIVE)
  sortOrder Int          @default(0) @map("sort_order")
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")
  @@unique([type, code])
  @@index([type, status])
  @@map("data_dictionary")
}

model CompanyInfo {
  id          String   @id @default(cuid())
  companyName String   @map("company_name") @db.VarChar(200)
  address     String?  @db.VarChar(500)
  phone       String?  @db.VarChar(50)
  fax         String?  @db.VarChar(50)
  logoUrl     String?  @map("logo_url") @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  @@map("company_info")
}
