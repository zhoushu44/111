<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <!-- 目标框架 .NET Framework 3.5（CLR2）：
         - Win7 自带 3.5.1、XP 装过 3.5 → 用 v2.0.50727 直接运行
         - Win10/11 未启用 .NET 3.5（CLR2 不存在）→ 回退到系统自带的 v4.0 兼容加载 3.5 程序集 -->
    <supportedRuntime version="v2.0.50727" />
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.0" />
  </startup>
</configuration>
