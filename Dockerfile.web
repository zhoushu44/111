# 多阶段构建：先构建前端（Vite），再用 nginx 提供静态文件并反向代理 /api
# 构建上下文为项目根目录（GitHub Actions 中 context: .）

# ---- 阶段 1：构建前端 ----
FROM node:24-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json* ./
RUN npm ci
COPY . .
# 关键：生产环境 API 走同源相对路径 /api（由 nginx 反代到后端），
# 覆盖根目录 .env 里遗留的 dev 值 http://localhost:3000/api
RUN VITE_API_BASE_URL=/api npx vite build

# ---- 阶段 2：nginx 提供静态资源 ----
FROM nginx:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/nginx.server.conf /etc/nginx/conf.d/default.conf
EXPOSE 7776
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost:7776/ >/dev/null 2>&1 || exit 1
